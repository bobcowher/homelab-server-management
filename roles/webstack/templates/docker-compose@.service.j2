[Unit]
Description=Docker Compose project %i
Requires=docker.service
# Starting containers before the firewall rules are in place leaves a window
# where published ports are open to the LAN.
After=docker.service docker-user-rules.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/docker/compose/%i
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
# Long enough for a cold image pull, but NOT unbounded. TimeoutStartSec=0
# means a hung `compose up` never fails and never completes -- the same class
# of problem as the wait-online timeout that delayed logins for two minutes.
# Fail loudly instead.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
