{#
  Rendered to /etc/default/grub.d/ramoops.cfg. See roles/diagnostics/tasks/main.yml.
  Files in /etc/default/grub.d are SOURCED by grub-mkconfig, so this is shell:
  appending to the variable preserves whatever other drop-ins have set, which
  matters because kdump-tools.cfg already puts crashkernel= there.
#}
# Managed by Ansible.
#
# reserve_mem carves a named region out of DRAM before the allocators start,
# and ramoops.mem_name finds it by that name. The pair exists so this does not
# have to hardcode a physical address that a BIOS update could invalidate.
#
# console_size is 0 and must stay 0 on this kernel: Ubuntu builds without
# CONFIG_PSTORE_CONSOLE, so the parameter is accepted, the memory is reserved,
# and no console is ever registered. ramoops therefore records on an oops or
# panic ONLY, which does NOT cover the NVMe dropout -- that never panics.
# lab-crash-watch covers that. See vars.yml.
# pstore.backend is NOT optional here. pstore accepts one backend and the
# first to register wins; on 2026-11-09 efi_pstore won and ramoops failed with
# -EBUSY while every configuration check still passed. Naming the backend is
# what makes the rest of this line do anything. See vars.yml.
GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT pstore.backend={{ diag_pstore_backend }} reserve_mem={{ diag_ramoops_total }}:4096:{{ diag_ramoops_region }} ramoops.mem_name={{ diag_ramoops_region }} ramoops.console_size={{ diag_ramoops_console_size }} ramoops.record_size={{ diag_ramoops_record_size }}"

# Two experiments against the NVMe dropouts, neither a setting anyone wants
# permanently. See vars.yml for the evidence behind each.
#
# APST (default 100000) is already ELIMINATED -- the drive died sooner with it
# off -- but it stays at 0 so only one variable changes at a time.
#
# HMB is the live experiment: max_host_mem_size_mb=0 disables the Host Memory
# Buffer this DRAM-less drive was using when its controller raised CFS.
GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT nvme_core.default_ps_max_latency_us={{ diag_nvme_apst_max_latency_us }} nvme.max_host_mem_size_mb={{ diag_nvme_hmb_max_mb }}"
