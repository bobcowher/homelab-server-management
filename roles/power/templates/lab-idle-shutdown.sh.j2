#!/bin/bash
# Managed by Ansible. See roles/power/tasks/main.yml.
#
# Decides whether the box may power off overnight, and does it. Run hourly
# across the overnight window by the matching timer.
#
# Powers OFF rather than suspending. Suspending to S3 with live VRAM corrupted
# both GPUs on 2026-09-07 -- Xid 31, then Xid 154 "Node Reboot Required" --
# because the driver saves and restores VRAM across S3 under
# NVreg_PreserveVideoMemoryAllocations=2. A cold boot reinitialises the driver
# from nothing, so that failure class cannot occur here. It also draws less
# than S3, and there is no RTC alarm to arm, no UTC conversion to get wrong,
# and no BIOS wake feature to depend on. The box comes back when someone
# presses the button.
#
# The bias throughout is toward STAYING UP. A false shutdown costs a work
# session -- a training run killed, an SSH session dropped. A needless wakeful
# night costs a few cents of idle draw. So every check below is a veto: any
# single one reporting activity cancels the shutdown, and anything this script
# cannot determine counts as activity.
#
# Run with --dry-run to print the verdict and every signal without acting.
set -uo pipefail

IDLE_MINUTES={{ power_idle_window_minutes }}
MIN_UPTIME_MINUTES={{ power_min_uptime_minutes }}
GPU_EXCLUDE_UNIT="{{ power_gpu_exclude_unit | default('') }}"
BOBGPT_UNIT="{{ power_bobgpt_unit | default('') }}"
LOAD_MAX="{{ power_idle_load_max }}"
CPU_MAX="{{ power_idle_cpu_max }}"
OVERRIDE_FLAG="{{ power_override_flag }}"
SYSSTAT_DIR="{{ power_sysstat_dir }}"
BEEKEEPER_URL="{{ power_beekeeper_url }}"
LLAMA_SWAP_UNIT="{{ power_llama_swap_unit }}"

DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
elif [[ -n "${1:-}" ]]; then
    echo "usage: ${0##*/} [--dry-run]" >&2
    exit 2
fi

# Every signal that reports activity appends here. Empty at the end means the
# box may power off.
#
# n_reasons is maintained alongside the array rather than read back with bash's
# array-length syntax. That syntax pairs a brace with a hash, and Ansible
# renders this file through Jinja, where that pair opens a comment -- the
# template fails with "Missing end of comment tag" and never installs.
reasons=()
n_reasons=0
veto() {
    reasons+=("$1")
    n_reasons=$(( n_reasons + 1 ))
}

# Printed for every signal whether or not it vetoes, so the journal shows the
# whole picture on a night that stayed up AND on one that went down.
report() { printf '  %-24s %s\n' "$1" "$2"; }

now_epoch=$(date +%s)
start_epoch=$(( now_epoch - IDLE_MINUTES * 60 ))

# --- Minimum uptime ---------------------------------------------------------
#
# Checked first, and printed first, because it is the signal that tells you
# whether to believe any of the ones below it.
#
# The sysstat window cannot see across a boot. Minutes the box spent powered
# off produce no samples, and no samples are indistinguishable from a quiet
# hour -- so a freshly booted machine reads as maximally idle, which is the
# exact opposite of the truth. The NO DATA guard below does not catch this: it
# tests for ZERO rows, and a box up twenty-five minutes already has two or
# three real ones, which is quite enough to compute a maximum of 0.00.
#
# That is how 2026-10-03 happened. Booted 07:35:50, the 08:00 check saw two
# samples spanning ten minutes, reported "Idle on every signal", and powered
# off 25 minutes after someone pressed the button to use the machine.
#
# The threshold is much longer than IDLE_MINUTES on purpose. It is not padding
# to cover the hole in the sar history -- it is honouring the button press.
# This box has no RTC alarm and no wake-on-LAN, so it is only ever running
# because a person physically switched it on, and that is the clearest
# statement of intent to use it that the machine ever receives.
uptime_minutes=$(( $(cut -d' ' -f1 /proc/uptime | cut -d. -f1) / 60 ))
report "uptime" "${uptime_minutes}m (min ${MIN_UPTIME_MINUTES}m)"
if (( uptime_minutes < MIN_UPTIME_MINUTES )); then
    veto "up only ${uptime_minutes}m, under the ${MIN_UPTIME_MINUTES}m minimum"
fi

# --- sysstat history --------------------------------------------------------
#
# sysstat already samples every 10 minutes, so the last hour of CPU and load is
# on disk with nothing new to install. It is also the ONLY signal here with a
# memory: everything else is instantaneous and would happily power off a box
# whose training run ended at 23:30.
#
# Two traps this handles:
#
#   * S_TIME_FORMAT=ISO is mandatory. Without it sar prints "12:10:09 AM" in
#     this locale -- an extra field that shifts every column right by one, so
#     reading ldavg-5 positionally silently returns ldavg-1 instead.
#   * At midnight the last hour reaches into YESTERDAY's saDD file. sar cannot
#     span two files in one call, so the window is read as two.
sar_window() {
    local flag="$1"
    local start_day now_day
    start_day=$(date -d "@${start_epoch}" +%d)
    now_day=$(date -d "@${now_epoch}" +%d)

    if [[ "$start_day" != "$now_day" ]]; then
        S_TIME_FORMAT=ISO sar "$flag" -f "${SYSSTAT_DIR}/sa${start_day}" \
            -s "$(date -d "@${start_epoch}" +%H:%M:%S)" 2>/dev/null
        S_TIME_FORMAT=ISO sar "$flag" -f "${SYSSTAT_DIR}/sa${now_day}" \
            -s 00:00:00 2>/dev/null
    else
        S_TIME_FORMAT=ISO sar "$flag" -f "${SYSSTAT_DIR}/sa${now_day}" \
            -s "$(date -d "@${start_epoch}" +%H:%M:%S)" 2>/dev/null
    fi
}

# Data rows only. Drops the banner, the column header, the trailing "Average:"
# line -- and the reboot marker, which is the subtle one.
#
# After a reboot sar emits "21:35:48     LINUX RESTART  (32 CPU)". That line
# BEGINS WITH A TIMESTAMP, so a filter matching only on $1 accepts it as data:
# the rows are non-empty, the NO DATA guard below never fires, and the maxima
# compute to 0.00 from a line containing no measurements. The script then reads
# a box it knows nothing about as idle -- precisely what that guard exists to
# prevent. Requiring numeric measurement columns excludes it.
sar_data() {
    awk '$1 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/ && $0 !~ /RESTART/ && NF >= 6'
}

load_rows=$(sar_window -q | sar_data)
cpu_rows=$(sar_window -u | sar_data)

if [[ -z "$load_rows" || -z "$cpu_rows" ]]; then
    # No history at all: a fresh boot, a wiped /var/log/sysstat, or a broken
    # collector. Unknown is not idle -- a box that came up ten minutes ago has
    # no business powering off on the strength of no evidence.
    report "cpu/load history" "NO DATA in last ${IDLE_MINUTES}m"
    veto "no sysstat history for the last ${IDLE_MINUTES} minutes"
else
    # Peak, not mean. A twenty-minute run inside a sixty-minute window averages
    # down to nothing; its peak stays visible.
    max_load=$(awk 'BEGIN{m=0} $5 ~ /^[0-9]/ {if ($5+0 > m) m=$5+0} END{printf "%.2f", m}' <<<"$load_rows")
    max_cpu=$(awk 'BEGIN{m=0} $2=="all" {u=$3+$5; if (u > m) m=u} END{printf "%.2f", m}' <<<"$cpu_rows")

    report "peak ldavg-5 (${IDLE_MINUTES}m)" "${max_load} (max ${LOAD_MAX})"
    report "peak cpu% (${IDLE_MINUTES}m)" "${max_cpu} (max ${CPU_MAX})"

    awk -v v="$max_load" -v t="$LOAD_MAX" 'BEGIN{exit !(v > t)}' \
        && veto "5-minute load peaked at ${max_load}, above ${LOAD_MAX}"
    awk -v v="$max_cpu" -v t="$CPU_MAX" 'BEGIN{exit !(v > t)}' \
        && veto "CPU peaked at ${max_cpu}%, above ${CPU_MAX}%"
fi

# --- LLM inference in the window --------------------------------------------
#
# Load alone misses this. A chat that finished at 23:45 leaves the box idle by
# midnight, and llama-swap unloads the model on its own TTL, so neither load
# nor VRAM remembers it happened. The request log does.
#
# Matched narrowly on inference paths. /v1/models is deliberately excluded --
# the verify playbook and assorted health checks poll it, and counting those
# would keep the box awake on its own monitoring.
# Counts inference requests in a stream of access-log lines. Shared with the
# bobgpt signal below, so the two cannot drift, and named so
# scripts/test_idle_checks.sh can extract and exercise the regex directly --
# it is the part that can actually be wrong.
completion_request_lines() {
    grep -cE '"(POST|GET) /v1/(chat/completions|completions|embeddings)'
}

llm_hits=$(journalctl -u "$LLAMA_SWAP_UNIT" --since "-${IDLE_MINUTES}min" \
    --no-pager -q 2>/dev/null | completion_request_lines )
report "llama-swap inference" "${llm_hits} request(s) in ${IDLE_MINUTES}m"
[[ "$llm_hits" -gt 0 ]] && veto "${llm_hits} LLM inference request(s) in the last ${IDLE_MINUTES} minutes"

# --- bobgpt inference --------------------------------------------------------
#
# Same reasoning as llama-swap above, for the from-scratch server. It needs its
# own signal for two reasons: its cgroup is excluded from the GPU check by
# design, so that cannot see it, and a 124M model generating short answers
# barely moves the load average, so the sar window cannot either.
#
# Without this, a conversation in progress would not stop the box powering off
# underneath it at midnight. That gap exists today for bobgpt and this closes
# it before the service is ever started.
if [[ -z "$BOBGPT_UNIT" ]]; then
    report "bobgpt inference" "not installed"
else
    bobgpt_hits=$(journalctl -u "$BOBGPT_UNIT" --since "-${IDLE_MINUTES}min" \
        --no-pager -q 2>/dev/null | completion_request_lines )
    report "bobgpt inference" "${bobgpt_hits} request(s) in ${IDLE_MINUTES}m"
    [[ "$bobgpt_hits" -gt 0 ]] && veto "${bobgpt_hits} bobgpt request(s) in the last ${IDLE_MINUTES} minutes"
fi

# --- Beekeeper --------------------------------------------------------------
#
# Authoritative for beekeeper-managed runs, and catches a run that is between
# phases -- checkpointing or evaluating -- where load can briefly read low.
#
# An unreachable API is treated as NOT active, which is the one place this
# script does not fail toward staying up. The reasoning: if beekeeper is down
# it is not starting anything, and a run that outlived a service restart
# (process_manager uses start_new_session, so training survives one) still
# shows up in the load and GPU checks above and below.
bk_json=$(curl -fsS --max-time 5 "$BEEKEEPER_URL" 2>/dev/null)
if [[ -z "$bk_json" ]]; then
    report "beekeeper" "unreachable (not treated as active)"
elif [[ "$(jq -r '.data.busy // false' <<<"$bk_json" 2>/dev/null)" == "true" ]]; then
    bk_projects=$(jq -r '(.data.running_projects // []) | join(", ")' <<<"$bk_json" 2>/dev/null)
    report "beekeeper" "BUSY (${bk_projects:-unnamed})"
    veto "beekeeper is training: ${bk_projects:-unnamed}"
else
    report "beekeeper" "idle"
fi

# --- GPU ---------------------------------------------------------------------
#
# Catches CUDA work started outside beekeeper entirely -- a script run by hand
# in tmux, a notebook -- which no API on this box would ever report.
#
# One unit may be excluded. bobgpt is a resident GPU service started by hand,
# and a CUDA context lives for the LIFE OF THE PROCESS once initialised:
# unloading the model frees VRAM, but the process keeps a context and stays
# listed here. Counting it would veto every overnight shutdown for as long as
# the service was left running.
#
# Excluded by IDENTITY -- the pids in its cgroup -- and not by switching the
# check off. Any other process holding a context still vetoes, which is the
# whole reason this signal exists. An empty or unknown unit name excludes
# nothing, so this is a no-op on a host where bobgpt was never installed.
#
# The cgroup rather than MainPID: a server may fork workers, and every one of
# them holds its own context.
not_excluded() {
    awk -v ex="$1" 'BEGIN{n=split(ex,a," "); for(i=1;i<=n;i++) e[a[i]]=1} $1 ~ /^[0-9]+$/ && !($1 in e)'
}

excluded_pids=""
if [[ -n "$GPU_EXCLUDE_UNIT" ]]; then
    cgroup_procs="/sys/fs/cgroup/system.slice/${GPU_EXCLUDE_UNIT}/cgroup.procs"
    [[ -r "$cgroup_procs" ]] && excluded_pids=$(tr '\n' ' ' < "$cgroup_procs")
fi

gpu_procs=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null \
    | tr -d ' ' | not_excluded "$excluded_pids" | grep -c .)
if [[ -n "$excluded_pids" ]]; then
    report "gpu compute processes" "${gpu_procs} (excluding ${GPU_EXCLUDE_UNIT})"
else
    report "gpu compute processes" "${gpu_procs}"
fi
[[ "$gpu_procs" -gt 0 ]] && veto "${gpu_procs} process(es) holding a CUDA context"

# --- Login sessions ----------------------------------------------------------
#
# Someone is at a terminal. Suspending would drop the connection and kill any
# foreground work that is not under tmux.
#
# NOT `who`. Ubuntu 26.04 no longer writes utmp, so `who` returns nothing even
# for a live interactive SSH session with a PTY -- this check would have looked
# correct and silently never fired. loginctl is the systemd-native registry and
# is the only source here that actually sees a session.
#
# Class=manager is excluded deliberately: that is the per-user systemd manager
# (user@UID.service), which outlives the login that started it and would
# otherwise pin the box awake permanently after a single SSH.
#
# Class is read per session rather than by column position, because
# `list-sessions` column order has changed between systemd releases.
#
# Ansible's own connection counts as a session, so a --dry-run during a deploy
# always reports at least one. That is expected and harmless: when the timer
# actually fires overnight, nothing is connected unless someone really is.
# Emits "<Class> <State>" per session, one per line.
session_states() {
    local sid
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
        printf '%s %s\n' \
            "$(loginctl show-session "$sid" -p Class --value 2>/dev/null)" \
            "$(loginctl show-session "$sid" -p State --value 2>/dev/null)"
    done
}

# State=closing is excluded, and that exclusion is load-bearing. A session whose
# leader has exited but which still contains a stray process sits in "closing"
# indefinitely -- logind will not reap it while anything remains in its cgroup.
# Counting those means one leaked background process pins the box awake forever.
#
# That is not hypothetical: a test stub leaked a python process on 2026-09-07,
# its session sat in "closing" for 19 hours, and it vetoed all nine overnight
# runs. Every other signal was clear on every one of them. Nobody was working;
# a corpse was.
#
# "active" and "online" both count -- online is a real login that simply is not
# the foreground session.
sessions_from_states() { awk '$1 == "user" && $2 != "closing"'; }

sessions=$(session_states | sessions_from_states | grep -c .)
report "login sessions" "${sessions}"
[[ "$sessions" -gt 0 ]] && veto "${sessions} login session(s) open"

# --- Manual override ---------------------------------------------------------
#
# Lives on /run, so it clears itself on the next boot. Forgetting to remove it
# costs one night, not every night.
if [[ -e "$OVERRIDE_FLAG" ]]; then
    report "manual override" "PRESENT (${OVERRIDE_FLAG})"
    veto "manual override flag ${OVERRIDE_FLAG} is present"
else
    report "manual override" "absent"
fi

# --- Verdict -----------------------------------------------------------------

if (( n_reasons > 0 )); then
    echo "Staying up. ${n_reasons} signal(s) report activity:"
    printf '  - %s\n' "${reasons[@]}"
    exit 0
fi

echo "Idle on every signal. Powering off."

if (( DRY_RUN )); then
    echo "(--dry-run: not powering off)"
    exit 0
fi

# systemctl rather than `poweroff` or `shutdown -h`, so units stop in
# dependency order and containers get a real SIGTERM instead of losing power
# mid-write. It returns once logind has queued the job, so this script exits
# normally on the way down.
if ! systemctl poweroff; then
    echo "systemctl poweroff failed. Still up." >&2
    exit 1
fi
