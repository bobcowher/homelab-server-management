# Managed by Ansible. Generated from llama_models in hosts/lab/vars.yml --
# edit there, not here.
healthCheckTimeout: {{ llama_swap_health_timeout | default(900) }}

{% if llama_models | default([]) | length > 0 %}
{% set swapping = [] %}
{% set resident = [] %}
{% for m in llama_models %}
{% if m.group | default('gpu') == 'resident' %}
{% set _ = resident.append(m) %}
{% else %}
{% set _ = swapping.append(m) %}
{% endif %}
{% endfor %}
groups:
{% if swapping | length > 0 %}
  # The swapping lane. At most ONE of these holds VRAM at a time, and starting
  # a second evicts the first. These models span both cards, so two resident at
  # once would not fit anyway. `exclusive` would also evict the resident lane
  # below -- `persistent` on that group is what prevents it.
  gpu:
    swap: true
    exclusive: true
    members:
{% for m in swapping %}
      - "{{ m.name }}"
{% endfor %}
{% endif %}
{% if resident | length > 0 %}
  # The resident lane: always-on models pinned to the 3060, which stay loaded
  # while the 3090 is free for training. `persistent` is the load-bearing flag
  # -- it stops the exclusive group above from unloading these when a big model
  # is called. `swap: false` lets more than one coexist if they fit.
  resident:
    swap: false
    exclusive: false
    persistent: true
    members:
{% for m in resident %}
      - "{{ m.name }}"
{% endfor %}
{% endif %}

models:
{% for m in llama_models %}
  "{{ m.name }}":
    # --network host with an explicit --host 127.0.0.1 keeps the backend on
    # loopback: nothing is published, so there is no LAN exposure and nothing
    # for the DOCKER-USER chain to filter.
    cmd: >
      docker run --rm --name llamacpp-{{ m.name }}
      --network host
      --gpus '"{{ m.gpus }}"'
      -e LLAMA_CACHE=/models/hf-cache
      -e CUDA_DEVICE_ORDER=PCI_BUS_ID
      -v {{ data_root }}/models:/models
      {{ llama_cpp_image }}
{% if m.hf is defined %}
      -hf {{ m.hf }}
{% else %}
      -m /models/{{ m.file }}
{% endif %}
      --host 127.0.0.1 --port ${PORT}
{% if m.ngl is defined %}
      -ngl {{ m.ngl }}
{% endif %}
{% if m.split_mode is defined %}
      -sm {{ m.split_mode }}
{% endif %}
{% if m.tensor_split is defined %}
      -ts {{ m.tensor_split }}
{% endif %}
{% if m.n_cpu_moe is defined %}
      --n-cpu-moe {{ m.n_cpu_moe }}
{% endif %}
{% if m.mmproj is defined %}
      --mmproj /models/{{ m.mmproj }}
{% endif %}
      -c {{ m.ctx | default(8192) }}
      --threads {{ m.threads | default(8) }}
      {{ m.args | default('') }}
    # A bare `docker run` does not die cleanly on signal; without this the
    # container outlives llama-swap's eviction and keeps holding VRAM.
    cmdStop: docker stop llamacpp-{{ m.name }}
    proxy: "http://127.0.0.1:${PORT}"
    ttl: {{ m.ttl | default(llama_swap_ttl_default) }}
{% endfor %}
{% else %}

# No models declared. llama-swap starts and serves with zero models; add
# entries to llama_models in hosts/lab/vars.yml.
models: {}
{% endif %}
