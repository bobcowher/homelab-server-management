#!/usr/bin/env python3
"""Get or set a GPU's GPC clock VF offset. Managed by Ansible (roles/nvidia).

Exists because `nvidia-smi` has no flag for this. The offset is the headless
equivalent of an undervolt: at a fixed power cap the card picks the highest
voltage/frequency point fitting the budget, and a positive offset makes each
voltage deliver more clock, so the same watts do more work. The usual Linux
route is `nvidia-settings -a GPUGraphicsClockOffset`, which needs an X server
this box does not have. NVML 525+ exposes it without X.

Uses ctypes against libnvidia-ml directly, so it needs no Python packages --
this runs from a systemd unit at boot, before any venv exists.

  gpu-clock-offset --gpu 1 --get
  gpu-clock-offset --gpu 1 --offset 100      (needs root)

Setting verifies the value read back, and exits non-zero if it did not take,
so the unit fails loudly rather than silently leaving the card at stock.
"""
import argparse
import ctypes
import sys

NVML_SUCCESS = 0
RC_NAMES = {0: "SUCCESS", 2: "INVALID_ARGUMENT", 3: "NOT_SUPPORTED",
            4: "NO_PERMISSION", 6: "NOT_FOUND"}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--gpu", type=int, required=True)
    group = ap.add_mutually_exclusive_group(required=True)
    group.add_argument("--get", action="store_true")
    group.add_argument("--offset", type=int)
    args = ap.parse_args()

    try:
        nvml = ctypes.CDLL("libnvidia-ml.so.1")
    except OSError as exc:
        print(f"cannot load libnvidia-ml: {exc}", file=sys.stderr)
        return 1

    if nvml.nvmlInit_v2() != NVML_SUCCESS:
        print("nvmlInit failed", file=sys.stderr)
        return 1

    dev = ctypes.c_void_p()
    if nvml.nvmlDeviceGetHandleByIndex_v2(args.gpu, ctypes.byref(dev)) != NVML_SUCCESS:
        print(f"no such GPU index {args.gpu}", file=sys.stderr)
        return 1

    def read():
        val = ctypes.c_int(0)
        rc = nvml.nvmlDeviceGetGpcClkVfOffset(dev, ctypes.byref(val))
        if rc != NVML_SUCCESS:
            print(f"read failed: {RC_NAMES.get(rc, rc)}", file=sys.stderr)
            return None
        return val.value

    if args.get:
        current = read()
        if current is None:
            return 1
        print(current)
        return 0

    # Refuse offsets outside what the driver permits, rather than letting it
    # fail obscurely.
    lo, hi = ctypes.c_int(0), ctypes.c_int(0)
    if nvml.nvmlDeviceGetGpcClkMinMaxVfOffset(
            dev, ctypes.byref(lo), ctypes.byref(hi)) == NVML_SUCCESS:
        if not lo.value <= args.offset <= hi.value:
            print(f"offset {args.offset} outside permitted "
                  f"{lo.value}..{hi.value}", file=sys.stderr)
            return 1

    rc = nvml.nvmlDeviceSetGpcClkVfOffset(dev, ctypes.c_int(args.offset))
    if rc != NVML_SUCCESS:
        print(f"set failed: {RC_NAMES.get(rc, rc)}"
              f"{' (needs root)' if rc == 4 else ''}", file=sys.stderr)
        return 1

    # Read back. A set that reports success but does not stick would otherwise
    # leave the card at stock while everything looked fine.
    applied = read()
    if applied != args.offset:
        print(f"set {args.offset} but read back {applied}", file=sys.stderr)
        return 1

    print(f"gpu {args.gpu} clock offset {applied} MHz")
    nvml.nvmlShutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
