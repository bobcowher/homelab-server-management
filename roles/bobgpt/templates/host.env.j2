# Managed by Ansible. See roles/bobgpt/tasks/main.yml.
#
# Every host-specific fact the bobgpt server needs, in one file, so the systemd
# unit and the repository's own deploy.sh read the same values from the same
# place. The unit loads this with EnvironmentFile; deploy.sh can `set -a;
# . /etc/bobgpt/host.env; set +a`.
#
# Nothing here names a run, a checkpoint, a model size, or a package version:
# those belong to github.com/bobcowher/bobgptv1. See
# docs/superpowers/specs/2026-10-04-bobgpt-serving-design.md.

# The checkout. Owned by robertcowher, so git pull needs no sudo.
BOBGPT_SRC={{ bobgpt_root }}/src

# Where the venv belongs. Ansible does NOT create it -- deploy.sh owns it, so
# dependencies never require an Ansible change.
BOBGPT_VENV={{ bobgpt_root }}/venv

# Build the venv from THIS interpreter. The 3.14 that ships natively has no
# torch wheels, which is the same trap the beekeeper role documents.
BOBGPT_PYTHON={{ bobgpt_python }}

# Read-only. One directory per run, each containing model.pth.
BOBGPT_CHECKPOINT_ROOT={{ bobgpt_checkpoint_root }}

# Binds all interfaces, because Open WebUI is a container and reaches host
# services via host.docker.internal -- the Docker bridge gateway, not
# loopback. A 127.0.0.1 bind is unreachable from there.
#
# It is still private: ufw default-denies incoming and allows this port only
# from the Docker bridge subnet, so nothing on the LAN can reach it.
BOBGPT_HOST={{ bobgpt_host }}
BOBGPT_PORT={{ bobgpt_port }}

BOBGPT_DEVICE={{ bobgpt_device }}
BOBGPT_MAX_LOADED={{ bobgpt_max_loaded }}

# The only directory the service may write. The unit is ProtectSystem=strict,
# so every other path is read-only.
BOBGPT_CACHE={{ bobgpt_root }}/cache
HOME={{ bobgpt_root }}/cache
XDG_CACHE_HOME={{ bobgpt_root }}/cache

# Set explicitly, and the one place this file names a library. tiktoken caches
# its downloaded BPE vocabulary in TIKTOKEN_CACHE_DIR, or else in
# tempfile.gettempdir() -- and with PrivateTmp=true that is a fresh empty
# directory on every start, so the vocabulary would be re-downloaded from the
# network each time the service came up. A start would then fail whenever
# openaipublic.blob.core.windows.net was unreachable.
TIKTOKEN_CACHE_DIR={{ bobgpt_root }}/cache/tiktoken

# Keeps device indices matching nvidia-smi's, so BOBGPT_DEVICE means what it
# looks like it means. Without this, CUDA orders by capability instead.
CUDA_DEVICE_ORDER=PCI_BUS_ID
